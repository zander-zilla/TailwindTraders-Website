# cp terraform.tfvars.example terraform.tfvars   (terraform.tfvars is git-ignored)
account_id  = "123456789012"
region      = "us-east-1"
name_prefix = "tt-demo"

# Optional: your SSO/admin role for kubectl access (the apply identity is admin automatically)
# admin_principal_arns = ["arn:aws:iam::123456789012:role/aws-reserved/sso.amazonaws.com/AWSReservedSSO_AdministratorAccess_xxxx"]

# Optional TLS (leave empty for HTTP on the ALB hostname)
# domain_name     = "shop.example.com"
# route53_zone_id = "Z0123456789ABCDEFGHIJ"

# Set false if the account already has the GitHub OIDC provider
# create_github_oidc_provider = false

# Phase 8 (Bedrock): enable model access for these in the Bedrock console (region above)
# bedrock_embedding_model_id = "amazon.titan-embed-text-v2:0"
# bedrock_chat_model_id      = "us.amazon.nova-lite-v1:0"
# assistant_enabled          = false
